{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM"], "strict": true, "skipLibCheck": true,
    "types": ["vite/client", "node"], "noEmit": true,
    "esModuleInterop": true, "forceConsistentCasingInFileNames": true,
    "paths": { "@timotf/atomm-ui": ["./src/index.ts"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "gallery/**/*.ts", "gallery/**/*.vue", "vite*.ts", "playwright.config.ts", "tests/**/*.ts"]
}
