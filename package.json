{
  "name": "@timotf/atomm-ui",
  "version": "0.28.2",
  "type": "module",
  "description": "Reusable Vue and Vuetify controls for locally computed atomm generators",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimotF/AtommUI.git"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "ASSET_LICENSES.md",
    "THIRD_PARTY_NOTICES.md",
    "licenses"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/atomm-ui.js"
    },
    "./style.css": "./dist/atomm-ui.css",
    "./compact.css": "./dist/compact.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./package.json": "./package.json",
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "vue-tsc -p tsconfig.json --noEmit",
    "build": "npm run check && vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite --config vite.gallery.config.ts",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "preview": "vite preview --config vite.gallery.config.ts",
    "test": "node --import ./tests/register-css-loader.mjs --test tests/contracts.test.mjs tests/component-contracts.test.mjs tests/composition.test.mjs tests/three.test.mjs",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "three": "^0.186.1",
    "vue": "^3.5.43",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@vitejs/plugin-vue": "6.0.9",
    "axe-core": "4.11.0",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12",
    "vuetify": "4.2.3"
  },
  "dependencies": {
    "@xmldom/xmldom": "0.9.12"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
