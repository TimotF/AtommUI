{
  "name": "@timotf/atomm-ui",
  "version": "0.4.1",
  "type": "module",
  "description": "Reusable Vue and Vuetify controls for locally computed atomm generators",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TimotF/AtommUI.git"
  },
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/atomm-ui.js"
    },
    "./style.css": "./dist/atomm-ui.css",
    "./compact.css": "./dist/compact.css",
    "./theme": {
      "types": "./dist/theme.d.ts",
      "import": "./dist/theme.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "check": "vue-tsc -p tsconfig.json --noEmit",
    "build": "npm run check && vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite --config vite.gallery.config.ts",
    "build:gallery": "vite build --config vite.gallery.config.ts",
    "preview": "vite preview --config vite.gallery.config.ts",
    "test": "node --import ./tests/register-css-loader.mjs --test tests/contracts.test.mjs tests/component-contracts.test.mjs",
    "test:browser": "playwright test"
  },
  "peerDependencies": {
    "vue": "^3.5.43",
    "vuetify": "^4.2.3"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vue": "3.5.43",
    "vue-tsc": "3.3.12",
    "vuetify": "4.2.3"
  }
}
